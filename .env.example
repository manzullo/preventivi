# Copia in .env e compila. I segreti non vanno mai nel repo.
# Nome e dominio provvisori: si cambiano quando il nome è deciso.
NEXT_PUBLIC_SITE_URL="http://localhost:4450"
# Solo per docker-compose (regole del proxy): dominio senza www, e la stessa
# stringa con i punti protetti per la regex del redirect da www.
SITE_HOST="preventivi.example"
SITE_HOST_RE="preventivi\\.example"
DATABASE_URL_BUILD="postgresql://preventivi:CAMBIAMI@127.0.0.1:5434/preventivi?schema=public"
DATABASE_URL="postgresql://preventivi:CAMBIAMI@localhost:5432/preventivi?schema=public"
POSTGRES_USER="preventivi"
POSTGRES_PASSWORD="CAMBIAMI"
POSTGRES_DB="preventivi"
APP_SECRET="64 caratteri esadecimali: openssl rand -hex 32"
ADMIN_EMAIL="manzullo@gmail.com"
ADMIN_PASSWORD="CAMBIAMI"
CRON_KEY="openssl rand -hex 16"
APIFY_TOKEN=""
INGEST_ENABLED="0"

# Fondo della mappa. Vuote = OpenStreetMap standard, gratuito e senza chiave.
# Da riempire solo per cambiare fornitore (es. Carto con chiave); l'attribuzione
# deve restare quella giusta per la fonte scelta, e il filtro "none" se il fondo
# e' gia' grigio.
NEXT_PUBLIC_TILE_URL=""
NEXT_PUBLIC_TILE_ATTRIBUTION=""
NEXT_PUBLIC_TILE_FILTER=""
